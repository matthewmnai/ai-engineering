*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# ===== 虚拟环境 conda/venv =====
.venv/
venv/
env/
ai_env/
unsloth_env/
conda-env/

# ===== 模型权重、LoRA、Checkpoint【最重要，禁止提交大权重到Git】 =====
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.adapter
*.gguf
checkpoint-*/
lora_outputs/
outputs/
train_output/
model_cache/
hf_cache/
models/
# models/ 下分 pretrained（基座，可重新下载）和 finetuned（微调产出，迁移必带）
# 两边都不入 Git，用 download_models.py 拉取

# ===== 训练中间状态（断点续训用，不入 Git） =====
checkpoints/
# Unsloth 运行时生成的 Triton 编译缓存（按 GPU 架构 JIT 产物，跨机器不通用）
unsloth_compiled_cache/

# ===== 数据集（大文件不上git；小数据需入git时直接放 courses/ 课程目录下） =====
*.parquet
*.arrow
*.zst
data/
dataset/
datasets/
# datasets/ 下分 public（公开，可重新下载）和 course（课程专属，迁移必带）
# 两边都不入 Git，用 download_datasets.py 拉取

# ===== 日志、中间输出 =====
*.log
logs/
*.out
*.err
wandb/
runs/
tensorboard/

# ===== Notebook =====
.ipynb_checkpoints
*.ipynb

# ===== 环境密钥配置，防止泄露PAT、API_KEY =====
.env
.env.local
.env.*
*.local
config.secret.yaml

# ===== AutoDL 临时目录 =====
autodl-tmp/
tmp/
temp/

